{
  "name": "@chibi.pl/nest-sequelize-db",
  "version": "0.0.2",
  "description": "NestJS Sequelize DB Module for easy use of databases in NestJS applications",
  "author": "Artur (Seti) Łabudziński",
  "license": "LGPL-3.0",
  "keywords": [
    "nestjs",
    "sequelize",
    "sequelize-typescript",
    "database",
    "orm",
    "migrations",
    "umzug"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ChibiPL/nest-sequelize-db.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true nest build",
    "prepack": "yarn build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "@nestjs/core": ">=9.0.0",
    "@nestjs/event-emitter": ">=3",
    "@nestjs/schedule": ">=9.0.0",
    "@nestjs/sequelize": ">=9.0.0",
    "rxjs": ">=7.0.0",
    "sequelize": ">=6.0.0",
    "sequelize-typescript": ">=2.0.0"
  },
  "dependencies": {
    "umzug": "^3.6.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/sequelize": "11.0.1",
    "@nestjs/testing": "11.1.28",
    "@stylistic/eslint-plugin-js": "^2.1.0",
    "@stylistic/eslint-plugin-ts": "^2.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.5",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "cross-env": "10.1.0",
    "eslint": "^9.23.0",
    "eslint-plugin-oxlint": "^0.4.0",
    "eslint-plugin-unicorn": "^53.0.0",
    "jest": "30.2.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "6.1.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "sqlite3": "^5.1.7",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
